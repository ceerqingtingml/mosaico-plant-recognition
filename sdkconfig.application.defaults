# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico plant_recognition"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
# ui_apps is a multi-megabyte GSP bundle. Let its boot-time SHA-256 finish
# before the OTA acceptance task computes the application hash.
CONFIG_ESP_MOSAICO_APP_ACCEPT_DELAY_MS=10000
